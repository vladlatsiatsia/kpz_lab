using System;
using System.Collections.Generic;
using System.Text;

namespace Lab3_Composite
{
    // СТРУКТУРА ПАТЕРНУ СТАН (STATE)
    public interface INodeState { string RenderState(LightElementNode node, Func<string> baseRender); }
    public class VisibleState : INodeState { public string RenderState(LightElementNode node, Func<string> baseRender) => baseRender(); }
    public class HiddenState : INodeState { public string RenderState(LightElementNode node, Func<string> baseRender) => ""; }

    class Program
    {
        static void Main(string[] args)
        {
            Console.OutputEncoding = Encoding.UTF8;
            var table = new LightElementNode("table", "block", "double");
            var tr = new LightElementNode("tr", "block", "double");
            table.AddChild(tr);

            Console.WriteLine("--- Тест Стейту (Зміна стану на Hidden) ---");
            Console.WriteLine("Початковий рендер:");
            Console.WriteLine(table.OuterRender());

            Console.WriteLine("\nПриховуємо рядок (tr.State = new HiddenState()):");
            tr.State = new HiddenState();
            Console.WriteLine(table.OuterRender()); // Тэг tr зникне з рендеру
        }
    }

    public interface IVisitor { void VisitTextNode(LightTextNode node); void VisitElementNode(LightElementNode node); }
    public class ElementCounterVisitor : IVisitor { public int Count { get; private set; } public void VisitTextNode(LightTextNode node) { } public void VisitElementNode(LightElementNode node) => Count++; }
    public abstract class LightNode { public string OuterRender() { OnCreated(); string result = Render(); OnTextRendered(); return result; } protected virtual void OnCreated() { } protected virtual void OnTextRendered() { } public abstract string Render(); public abstract void Accept(IVisitor visitor); }
    public class LightTextNode : LightNode { private string _text; public LightTextNode(string text) => _text = text; public override string Render() => _text; public override void Accept(IVisitor visitor) => visitor.VisitTextNode(this); }

    public class LightElementNode : LightNode
    {
        private string _tagName;
        private List<LightNode> _children = new List<LightNode>();
        
        // Властивість для збереження Станy
        public INodeState State { get; set; } = new VisibleState();

        public LightElementNode(string tag, string display, string closing) => _tagName = tag;
        public void AddChild(LightNode node) => _children.Add(node);
        public IEnumerable<LightNode> GetDepthFirstIterator() { yield return this; foreach (var child in _children) { if (child is LightElementNode elementChild) { foreach (var subChild in elementChild.GetDepthFirstIterator()) yield return subChild; } else yield return child; } }
        protected override void OnCreated() { }

        // Делегуємо рендер стану
        public override string Render()
        {
            return State.RenderState(this, () =>
            {
                StringBuilder sb = new StringBuilder();
                sb.Append($"<{_tagName}>");
                foreach (var child in _children) sb.Append(child.OuterRender());
                sb.Append($"</{_tagName}>");
                return sb.ToString();
            });
        }
        public override void Accept(IVisitor visitor) { visitor.VisitElementNode(this); foreach (var child in _children) child.Accept(visitor); }
    }
}
